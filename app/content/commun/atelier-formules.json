    "id": "f09",
    "cat": "Mathématiques",
    "name": "Suite arithmétique (terme général)",
    "inputs": [
      {
        "symbol": "a",
        "label": "Premier terme u₀",
        "min": 10,
        "max": 100,
        "step": 1
      },
      {
        "symbol": "b",
        "label": "Raison r",
        "min": -5,
        "max": 10,
        "step": 1
      },
      {
        "symbol": "c",
        "label": "Rang n",
        "min": 2,
        "max": 20,
        "step": 1
      }
    ],
    "expression": [
      "+",
      "a",
      [
        "*",
        "c",
        "b"
      ]
    ],
    "unit": "",
    "terminale": false,
    "formula": "uₙ = u₀ + n × r",
    "note": "ou uₙ = u₁ + (n − 1) × r"
  },
  {
    "id": "f10",
    "cat": "Mathématiques",
    "name": "Suite géométrique (terme général)",
    "inputs": [
      {
        "symbol": "a",
        "label": "Premier terme u₀",
        "min": 10,
        "max": 100,
        "step": 10
      },
