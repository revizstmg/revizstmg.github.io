[
  {
    "id": "f01",
    "cat": "Mathématiques",
    "name": "Proportion",
    "inputs": [
      {
        "symbol": "a",
        "label": "Effectif de la partie",
        "min": 1,
        "max": 20,
        "step": 1
      },
      {
        "symbol": "b",
        "label": "Effectif total",
        "min": 25,
        "max": 100,
        "step": 1
      }
    ],
    "expression": [
      "*",
      [
        "/",
        "a",
        "b"
      ],
      100
    ],
    "unit": "%",
    "terminale": false,
    "formula": "Partie ÷ Tout × 100",
    "note": ""
  },
  {
    "id": "f02",
    "cat": "Mathématiques",
    "name": "x % d’une valeur V",
    "inputs": [
      {
        "symbol": "a",
        "label": "Pourcentage x",
        "min": 5,
        "max": 80,
        "step": 5
      },
      {
        "symbol": "b",
        "label": "Valeur V",
        "min": 100,
        "max": 2000,
        "step": 50
      }
    ],
    "expression": [
      "/",
      [
        "*",
        "a",
        "b"
      ],
      100
    ],
    "unit": "",
    "terminale": false,
    "formula": "V × x ÷ 100",
    "note": ""
  },
  {
    "id": "f03",
    "cat": "Mathématiques",
    "name": "Taux d’évolution",
    "inputs": [
      {
        "symbol": "a",
        "label": "Valeur initiale",
        "min": 100,
        "max": 1000,
        "step": 20
      },
      {
        "symbol": "b",
        "label": "Valeur finale",
        "min": 100,
        "max": 1500,
        "step": 20
      }
    ],
    "expression": [
      "*",
      [
        "/",
        [
          "-",
          "b",
          "a"
        ],
        "a"
      ],
      100
    ],
    "unit": "%",
    "terminale": false,
    "formula": "t = (V arrivée − V départ) ÷ V départ",
    "note": "× 100 pour l’avoir en %"
  },
  {
    "id": "f04",
    "cat": "Mathématiques",
    "name": "Coefficient multiplicateur",
    "inputs": [
      {
        "symbol": "a",
        "label": "Taux d’évolution en % (positif : hausse)",
        "min": -40,
        "max": 50,
        "step": 5
      }
    ],
    "expression": [
      "+",
      1,
      [
        "/",
        "a",
        100
      ]
    ],
    "unit": "",
    "terminale": false,
    "formula": "CM = 1 + t",
    "note": "+8 % → 1,08 ; −8 % → 0,92"
  },
  {
    "id": "f05",
    "cat": "Mathématiques",
    "name": "Valeur d’arrivée",
    "inputs": [
      {
        "symbol": "a",
        "label": "Valeur initiale",
        "min": 100,
        "max": 2000,
        "step": 50
      },
      {
        "symbol": "b",
        "label": "Taux d’évolution en %",
        "min": -40,
        "max": 50,
        "step": 5
      }
    ],
    "expression": [
      "*",
      "a",
      [
        "+",
        1,
        [
          "/",
          "b",
          100
        ]
      ]
    ],
    "unit": "",
    "terminale": false,
    "formula": "V arrivée = V départ × CM",
    "note": "donc CM = V arrivée ÷ V départ"
  },
  {
    "id": "f06",
    "cat": "Mathématiques",
    "name": "Évolutions successives",
    "inputs": [
      {
        "symbol": "a",
        "label": "Premier taux en %",
        "min": -30,
        "max": 40,
        "step": 5
      },
      {
        "symbol": "b",
        "label": "Deuxième taux en %",
        "min": -30,
        "max": 40,
        "step": 5
      }
    ],
    "expression": [
      "*",
      [
        "-",
        [
          "*",
          [
            "+",
            1,
            [
              "/",
              "a",
              100
            ]
          ],
          [
            "+",
            1,
            [
              "/",
              "b",
              100
            ]
          ]
        ],
        1
      ],
      100
    ],
    "unit": "%",
    "terminale": false,
    "formula": "CM global = CM₁ × CM₂ × … × CMₙ",
    "note": "on n’additionne jamais les taux",
    "target": "Taux d’évolution global en %"
  },
  {
    "id": "f07",
    "cat": "Mathématiques",
