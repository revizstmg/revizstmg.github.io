        "title": "Probabilités",
        "items": [
          {
            "name": "Probabilité conditionnelle",
            "f": "P_A(B) = P(A ∩ B) ÷ P(A)"
          },
          {
            "name": "Probabilité d’un chemin",
            "f": "P(A ∩ B) = P(A) × P_A(B)",
            "note": "on multiplie le long des branches"
          },
          {
            "name": "Probabilités totales",
            "f": "P(B) = P(A) × P_A(B) + P(Ā) × P_Ā(B)"
          },
          {
            "name": "Réunion",
            "f": "P(A ∪ B) = P(A) + P(B) − P(A ∩ B)"
          },
          {
            "name": "Indépendance",
            "f": "P(A ∩ B) = P(A) × P(B)",
            "note": "équivaut à P_A(B) = P(B)"
          },
          {
            "name": "Espérance d’une variable aléatoire",
            "f": "E(X) = Somme des (valeur × probabilité)"
          }
        ]
