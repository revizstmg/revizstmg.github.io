        "title": "Second degré et dérivation",
        "items": [
          {
            "name": "Fonction du second degré",
            "f": "f(x) = ax² + bx + c",
            "note": "a ≠ 0, courbe : parabole"
          },
          {
            "name": "Discriminant",
            "f": "Δ = b² − 4ac",
            "note": "Δ > 0 : 2 racines ; Δ = 0 : 1 ; Δ < 0 : aucune"
          },
          {
            "name": "Racines (Δ > 0)",
            "f": "x = (−b ± √Δ) ÷ (2a)"
          },
          {
            "name": "Abscisse du sommet",
            "f": "α = −b ÷ (2a)"
          },
          {
            "name": "Dérivée d’une constante",
            "f": "(k)′ = 0"
          },
          {
            "name": "Dérivée de x",
            "f": "(x)′ = 1"
          },
          {
            "name": "Dérivée de x²",
            "f": "(x²)′ = 2x"
          },
          {
            "name": "Dérivée de xⁿ",
            "f": "(xⁿ)′ = n·xⁿ⁻¹"
          },
          {
            "name": "Dérivée de 1/x",
            "f": "(1/x)′ = −1/x²",
            "note": "x ≠ 0"
          },
          {
            "name": "Dérivée d’un trinôme",
            "f": "(ax² + bx + c)′ = 2ax + b"
          },
          {
            "name": "Dérivée d’une somme",
            "f": "(u + v)′ = u′ + v′"
          },
          {
            "name": "Dérivée de k·u",
            "f": "(k·u)′ = k·u′"
          },
          {
            "name": "Tangente au point d’abscisse a",
            "f": "y = f′(a)(x − a) + f(a)",
            "note": "f′(a) = coefficient directeur"
          },
          {
            "name": "Sens de variation",
            "f": "f′ > 0 : croissante ; f′ < 0 : décroissante",
            "note": "f′ s’annule en changeant de signe : extremum"
          }
