      {
        "title": "Suites",
        "items": [
          {
            "name": "Suite arithmétique (récurrence)",
            "f": "uₙ₊₁ = uₙ + r"
          },
          {
            "name": "Suite arithmétique (terme général)",
            "f": "uₙ = u₀ + n × r",
            "note": "ou uₙ = u₁ + (n − 1) × r"
          },
          {
            "name": "Suite géométrique (récurrence)",
            "f": "uₙ₊₁ = uₙ × q",
            "note": "évolution de p % : q = 1 + p/100"
          },
          {
            "name": "Suite géométrique (terme général)",
            "f": "uₙ = u₀ × qⁿ",
            "note": "ou uₙ = u₁ × qⁿ⁻¹"
          },
          {
            "name": "Somme de termes géométriques",
            "f": "S = u₀ × (1 − qⁿ) ÷ (1 − q)",
            "note": "n = nombre de termes, q ≠ 1"
          },
          {
            "name": "Variations d’une suite arithmétique",
            "f": "r > 0 : croissante ; r < 0 : décroissante"
          },
          {
            "name": "Variations d’une suite géométrique",
            "f": "q > 1 : croissante ; 0 < q < 1 : décroissante",
            "note": "avec u₀ > 0"
          }
        ]
      },
