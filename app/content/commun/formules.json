        "title": "Loi binomiale, loi normale et estimation",
        "items": [
          {
            "name": "Loi binomiale B(n ; p)",
            "f": "P(X = k) = C(n, k) × pᵏ × (1 − p)ⁿ⁻ᵏ",
            "note": "à la calculatrice"
          },
          {
            "name": "Au moins k succès",
            "f": "P(X ≥ k) = 1 − P(X ≤ k − 1)"
          },
          {
            "name": "Espérance (loi binomiale)",
            "f": "E(X) = n × p"
          },
          {
            "name": "Variance (loi binomiale)",
            "f": "V(X) = n × p × (1 − p)"
          },
          {
            "name": "Écart-type (loi binomiale)",
            "f": "σ(X) = √(n × p × (1 − p))"
          },
          {
            "name": "Loi normale N(μ ; σ) : à 1 σ",
            "f": "P(μ − σ ≤ X ≤ μ + σ) ≈ 0,68"
          },
          {
            "name": "Loi normale N(μ ; σ) : à 2 σ",
            "f": "P(μ − 2σ ≤ X ≤ μ + 2σ) ≈ 0,95"
          },
          {
            "name": "Loi normale N(μ ; σ) : à 3 σ",
            "f": "P(μ − 3σ ≤ X ≤ μ + 3σ) ≈ 0,997"
          },
          {
            "name": "Symétrie de la loi normale",
            "f": "P(X ≤ μ) = P(X ≥ μ) = 0,5"
          },
          {
            "name": "Intervalle de confiance à 95 %",
            "f": "[f − 1/√n ; f + 1/√n]",
            "note": "f : fréquence observée, n : taille de l’échantillon"
          },
          {
            "name": "Amplitude de l’intervalle",
            "f": "2 ÷ √n"
          }
        ]
      }
