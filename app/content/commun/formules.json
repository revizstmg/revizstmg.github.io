          {
            "name": "Coefficient multiplicateur",
            "f": "CM = 1 + t",
            "note": "+8 % → 1,08 ; −8 % → 0,92"
          },
          {
            "name": "Valeur d’arrivée",
            "f": "V arrivée = V départ × CM",
            "note": "donc CM = V arrivée ÷ V départ"
          },
          {
            "name": "Évolutions successives",
            "f": "CM global = CM₁ × CM₂ × … × CMₙ",
            "note": "on n’additionne jamais les taux"
          },
          {
            "name": "Taux moyen",
            "f": "CM moyen = (CM global)^(1/n) ; t moyen = CM moyen − 1"
          },
          {
            "name": "Évolution réciproque",
            "f": "CM réciproque = 1 ÷ CM",
