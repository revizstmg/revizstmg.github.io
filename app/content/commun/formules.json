          {
            "name": "Net commercial",
            "f": "Brut HT − Rabais − Remise − Ristourne"
          },
          {
            "name": "Net financier",
            "f": "Net commercial − Escompte"
          },
          {
            "name": "Net à payer TTC",
            "f": "Net financier + TVA",
            "note": "TVA = Net financier × taux"
          },
          {
            "name": "Partie double",
            "f": "Total des débits = Total des crédits"
          }
        ]
      },
      {
        "title": "Stocks et immobilisations",
