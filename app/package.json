{
  "name": "stmg-revision",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site de révision interactif pour la Terminale STMG — jeux par matière et par chapitre.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node pwa-postbuild.mjs",
